{
  "compilerOptions": {
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023"],
    "module": "ES6",
    "moduleResolution": "Node",
    "noEmit": true,
    "noErrorTruncation": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2020"
  },
  "exclude": ["./dist", "./lib"],
  "include": ["src/**/*.ts"]
}
